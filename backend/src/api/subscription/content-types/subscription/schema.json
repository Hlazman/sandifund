{
  "kind": "collectionType",
  "collectionName": "subscriptions",
  "info": {
    "singularName": "subscription",
    "pluralName": "subscriptions",
    "displayName": "Subscription"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "plan": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::subscription-plan.subscription-plan"
    },
    "subscriptionStatus": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "enum": [
        "active",
        "cancelled",
        "paused"
      ]
    },
    "nextPaymentDate": {
      "type": "date",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "transactions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::transaction.transaction",
      "mappedBy": "subscription"
    },
    "paymentMethod": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::payment-method.payment-method"
    }
  }
}
