{
  "kind": "collectionType",
  "collectionName": "user_infos",
  "info": {
    "singularName": "user-info",
    "pluralName": "user-infos",
    "displayName": "UserInfo"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "user_info"
    },
    "language": {
      "type": "enumeration",
      "enum": [
        "en",
        "he",
        "uk",
        "ru"
      ]
    },
    "donationSum": {
      "type": "decimal",
      "default": 0,
      "min": 0
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "selected_funds": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::fund.fund"
    },
    "subscriptions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::subscription.subscription"
    },
    "isMaster": {
      "type": "boolean",
      "default": false
    },
    "isFree": {
      "type": "boolean",
      "default": false
    },
    "notifications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::notification.notification"
    },
    "master": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::master.master",
      "mappedBy": "user_info"
    }
  }
}
